# Copy this to .env for local development.
# In production (Vercel), set these in Project Settings > Environment Variables
# instead of committing a .env file.

PORT=3000

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Preferred for server-side use (bypasses RLS) - if you have one, set this instead:
# SUPABASE_SERVICE_ROLE_KEY=

# SMTP (Gmail example - use an App Password, not your login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# PayMongo
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Must be the real public URL of your deployment, e.g. https://your-app.vercel.app
APP_BASE_URL=http://localhost:3000
